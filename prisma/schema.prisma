// TEMPPO Reservas — data model
// Money is stored as integer cents everywhere to avoid float drift.
// Every tenant-owned row carries studioId so multi-studio hosting works unchanged.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- tenancy

/// What a studio sells. Classes are the original group-capacity model; appointments
/// are 1:1 services of variable length (nails, lashes, hair) and live in their own
/// tables so neither side has to carry the other's rules.
enum Vertical {
  CLASSES
  APPOINTMENTS
}

enum Plan {
  TRIAL
  ESSENTIAL
  STUDIO
  NETWORK
}

model Studio {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  timezone String @default("America/Montevideo")
  currency String @default("UYU")
  locale   String @default("es")

  // Branding is available on every plan by design — never gate these.
  /// Studio WhatsApp in international format, e.g. +59899123456.
  /// Students send transfer receipts here; also used for the support link.
  whatsappNumber String?

  logoUrl     String?
  accentColor String  @default("#E07A5F")

  plan        Plan      @default(TRIAL)
  trialEndsAt DateTime?

  // Studio-configurable booking rules
  cancellationCutoffHours Int @default(6)
  reminderHoursBefore     Int @default(12)
  waitlistClaimWindowMins Int @default(120)
  noShowLimit             Int @default(3) // 0 disables no-show restrictions
  bookingOpensDaysAhead   Int @default(30)

  /// How many fixed-spot classes a student may swap in a calendar month.
  /// Cancelling within this allowance earns a make-up usable until month end;
  /// beyond it the class is simply lost. 0 disables swapping entirely.
  monthlyChangesAllowed Int @default(2)

  /// Set by a platform admin to cut off access without deleting anything.
  /// Login is refused while this is set.
  suspendedAt     DateTime?
  suspendedReason String?

  /// Last time the calendar was generated for this studio. Read straight off
  /// the studio record the guard already loaded, so the common page view can
  /// skip the whole job without spending a single query to find out.
  instancesSyncedAt DateTime?

  /// Which product the studio signed up to, and which brand (domain, name,
  /// colours, sender) it belongs to. Fixed at signup by the host it came from.
  vertical Vertical @default(CLASSES)
  brand    String   @default("temppo")

  // Appointment rules — ignored by class studios.
  /// How long an unpaid booking holds its slot before it is released.
  holdMinutes       Int     @default(15)
  /// The soonest a client may book online, in minutes from now.
  minNoticeMinutes  Int     @default(120)
  /// Granularity of offered start times.
  slotStepMinutes   Int     @default(15)
  /// Whether an in-time cancellation gives the deposit back. When false the
  /// deposit is kept as credit towards the next visit instead.
  depositRefundable Boolean @default(false)
  /// Which ways a client may pay a deposit. A studio that does not want Mercado
  /// Pago's fee can take transfers only; with both off, bookings confirm
  /// straight away and no deposit is asked.
  acceptMercadoPago Boolean @default(true)
  acceptTransfer    Boolean @default(true)

  /// LINK: staff send reminders from their own WhatsApp (wa.me). CLOUD: the
  /// platform sends them automatically, within a monthly quota.
  waMode           String    @default("LINK")
  waMonthlyQuota   Int       @default(0)
  waSentThisPeriod Int       @default(0)
  waPeriodStart    DateTime?

  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  serviceCategories ServiceCategory[]
  services          Service[]
  addOns            AddOn[]
  workingHours      WorkingHours[]
  timeOff           TimeOff[]
  appointments      Appointment[]
  payouts           StudioPayout[]
  inboxItems        InboxItem[]

  locations         Location[]
  users             User[]
  classTemplates    ClassTemplate[]
  classInstances    ClassInstance[]
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  classPacks        ClassPack[]
  studentPacks      StudentPack[]
  payments          Payment[]
  transactions      Transaction[]
  notifications     NotificationLog[]
  auditLogs         AuditLog[]
  leads             Lead[]
  recurringBookings RecurringBooking[]
  subscription      Subscription?

  @@index([slug])
}

model Location {
  id       String  @id @default(cuid())
  studioId String
  studio   Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name     String
  address  String?
  timezone String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classTemplates ClassTemplate[]
  classInstances ClassInstance[]
  /// Which students train here. A person can belong to several sucursales —
  /// reformer at one, mat at another — so this is a plain many-to-many.
  students       StudentProfile[]

  @@index([studioId])
}

// ------------------------------------------------------------------ people

enum Role {
  OWNER
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Optional: an older student may have no email at all. Staff still need one
  /// — they sign in with a password or a magic link.
  email              String?
  passwordHash       String?
  /// National ID (cédula). The sign-in handle for a student with no email.
  documentId         String?
  /// Short PIN backing a documentId sign-in. Hashed like a password.
  pinHash            String?
  name               String
  phone              String?
  role               Role      @default(STUDENT)
  isActive           Boolean   @default(true)
  emailVerified      DateTime?
  /// Stamped the first time the guided tour opens. Kept on the account rather
  /// than in localStorage so it survives a new device, a cleared browser or
  /// a private window — the tour is meant to appear once, not once per store.
  /// Set when staff hand out a temporary password. The account works, but is
  /// held at the password screen until the person picks their own.
  mustChangePassword Boolean   @default(false)

  tourSeenAt DateTime?

  /// The home panel as this person arranged it: { order: string[], hidden: string[] }.
  /// Kept on the account so the same layout follows her to every device.
  homeLayout Json?

  /// Platform operator, not a studio role. Grants access to /admin across
  /// every studio. Deliberately a flag rather than a Role: Role describes what
  /// someone does inside their studio, and this cuts across all of them.
  isPlatformAdmin Boolean @default(false)
  locale          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile     StudentProfile?
  instructorProfile  InstructorProfile?
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  approvedPayments   Payment[]           @relation("PaymentApprover")
  pushSubscriptions  PushSubscription[]
  inbox              InboxItem[]

  // As a professional on an appointment studio.
  servicesOffered   ServiceStaff[]
  workingHours      WorkingHours[]
  timeOff           TimeOff[]
  staffAppointments Appointment[]  @relation("AppointmentStaff")

  // The same person can train at several studios, so identity is scoped to
  // the studio rather than global. One row per person per studio, which is
  // also what makes their history (packs, no-shows, notes) studio-local.
  @@unique([studioId, email])
  @@unique([studioId, documentId])
  @@index([studioId, role])
  @@index([studioId, phone])
  @@index([email])
  @@index([documentId])
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate        DateTime?
  healthNotes      String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  /// Appointment studios: what a technician must know before touching
  /// someone — latex, acetone, lash glue.
  allergies        String?
  lastVisitAt      DateTime?

  // Rolling counter maintained on attendance marking; reset by admins.
  noShowCount    Int     @default(0)
  bookingBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The sucursales this student belongs to. Empty means "not yet assigned"
  /// rather than "barred" — it filters what they see, it does not gate booking.
  locations Location[]

  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  packs             StudentPack[]
  payments          Payment[]
  leads             Lead[]
  recurringBookings RecurringBooking[]
  appointments      Appointment[]
}

model InstructorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio      String?
  colorHex String? // used to tint the calendar

  // Payroll: per-class rate wins when set, otherwise the hourly rate applies.
  payPerClassCents Int?
  payPerHourCents  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classTemplates ClassTemplate[]
  classInstances ClassInstance[]
}

// ----------------------------------------------------------------- classes

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

// A recurring definition. One-off classes skip this and exist only as instances.
model ClassTemplate {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  locationId   String?
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instructorId String?
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  name         String
  description  String?
  colorHex     String  @default("#C0563C")
  capacity     Int     @default(10)
  durationMins Int     @default(60)

  // Recurrence: which weekdays (0=Sunday..6=Saturday) and what wall-clock start.
  weekdays  Int[]
  startTime String // "HH:mm" in the studio timezone
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances         ClassInstance[]
  recurringBookings RecurringBooking[]

  @@index([studioId, isActive])
}

// A concrete, bookable occurrence on the calendar.
model ClassInstance {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  templateId   String?
  template     ClassTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instructorId String?
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  name     String
  colorHex String      @default("#C0563C")
  startsAt DateTime
  endsAt   DateTime
  capacity Int
  status   ClassStatus @default(SCHEDULED)
  notes    String?

  allowTrialBooking Boolean   @default(true) // surfaces the class in the public lead-capture flow
  remindersSentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  leads           Lead[]

  @@unique([templateId, startsAt])
  @@index([studioId, startsAt])
}

// ---------------------------------------------------------------- bookings

enum BookingStatus {
  BOOKED
  CANCELLED
  LATE_CANCELLED
  ATTENDED
  NO_SHOW
}

enum BookingSource {
  STUDENT
  ADMIN
  WAITLIST
  TRIAL
  RECURRING
  /// On the house — a birthday class or similar. Spends no credit, and stays
  /// distinguishable from a paid booking in the reports.
  GIFT
}

enum RecurringBookingStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// A standing weekly spot: "Ana has Monday 17:00 Reformer every week".
/// Held against the recurring template, then materialised into a Booking on
/// each occurrence, so a fixed spot occupies capacity before casual booking.
model RecurringBooking {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  classTemplateId String
  classTemplate   ClassTemplate  @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Which of the template's weekdays this spot actually covers.
  /// A class running Mon/Wed/Fri is one template, but a student may hold only
  /// Monday and Wednesday — so the days live on the spot, not the template.
  weekdays Int[]

  status    RecurringBookingStatus @default(ACTIVE)
  startDate DateTime               @db.Date
  endDate   DateTime?              @db.Date
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  // One standing spot per student per weekly slot.
  @@unique([classTemplateId, studentId])
  @@index([studioId, status])
}

model Booking {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  classInstanceId String
  classInstance   ClassInstance  @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status BookingStatus @default(BOOKED)
  source BookingSource @default(STUDENT)

  // Credit consumed for this booking, refunded on an in-window cancellation.
  studentPackId String?
  studentPack   StudentPack? @relation(fields: [studentPackId], references: [id], onDelete: SetNull)

  // Set when this booking was generated by a standing weekly spot.
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)

  /// This cancellation was inside the monthly allowance, so it granted a
  /// make-up. Recorded on the booking rather than counted after the fact,
  /// because the allowance is judged at the moment of cancelling.
  earnedMakeup Boolean @default(false)
  /// This booking was paid for with a make-up rather than a pack credit.
  usedMakeup   Boolean @default(false)

  checkInToken String    @unique @default(cuid()) // encoded into the QR
  checkedInAt  DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A student holds at most one booking row per class occurrence.
  @@unique([classInstanceId, studentId])
  @@index([studioId, status])
  @@index([studentId])
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CLAIMED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  classInstanceId String
  classInstance   ClassInstance  @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  position       Int
  status         WaitlistStatus @default(WAITING)
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  claimToken     String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classInstanceId, studentId])
  @@index([classInstanceId, position])
}

// ---------------------------------------------------------- packs & money

model ClassPack {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  credits      Int // ignored when isUnlimited
  isUnlimited  Boolean @default(false)
  priceCents   Int
  validityDays Int     @default(30)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentPacks StudentPack[]

  @@index([studioId, isActive])
}

enum StudentPackStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

model StudentPack {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packId    String
  pack      ClassPack      @relation(fields: [packId], references: [id])

  creditsTotal Int
  creditsUsed  Int               @default(0)
  isUnlimited  Boolean           @default(false)
  status       StudentPackStatus @default(PENDING_PAYMENT)
  startsAt     DateTime          @default(now())
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  payments Payment[]

  @@index([studentId, status])
}

enum PaymentMethod {
  MERCADO_PAGO
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model Payment {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentPackId String?
  studentPack   StudentPack? @relation(fields: [studentPackId], references: [id], onDelete: SetNull)

  /// A deposit (seña) for an appointment rather than a pack purchase.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Set once the platform has passed this money on to the studio. Only
  /// online deposits are collected by the platform; transfers and cash go
  /// straight to the studio and never appear in a payout.
  payoutId String?
  payout   StudioPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  amountCents Int
  currency    String        @default("UYU")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  // Manual bank-transfer flow.
  /// Short code the student quotes when sending the receipt over WhatsApp, so
  /// staff can match an incoming message to the pending payment at a glance.
  shortCode      String?
  proofUrl       String?
  reference      String?
  approvedById   String?
  approvedBy     User?     @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  rejectedReason String?

  // Set by whichever payment provider handled it (provider-agnostic).
  provider          String?
  providerPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([studioId, status])
  @@index([studentId])
  @@index([studioId, shortCode])
  @@index([appointmentId])
  @@index([studioId, payoutId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  type        TransactionType
  category    String
  description String?
  amountCents Int
  occurredAt  DateTime        @default(now())

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, occurredAt])
}

// ------------------------------------------------------- comms, audit, leads

enum NotificationChannel {
  EMAIL
  /// Automatic WhatsApp through the Cloud API, a paid add-on for appointment
  /// studios. Class studios never send on it.
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model NotificationLog {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  channel   NotificationChannel
  template  String
  recipient String
  status    NotificationStatus  @default(QUEUED)
  error     String?
  payload   Json?

  // Loose references — a log row must survive deletion of what it refers to.
  relatedType String?
  relatedId   String?

  /// The provider's own id for the message (WhatsApp's wamid), so its later
  /// delivery and failure callbacks find the row they belong to.
  providerMessageId String? @unique

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([studioId, createdAt])
}

/// A phone that replied BAJA to our WhatsApp number. Platform-wide: every
/// studio sends from the same number, so to her it is one sender to stop.
model WhatsAppOptOut {
  /// Digits only, with country code: 59899123456.
  phone     String   @id
  createdAt DateTime @default(now())
}

model AuditLog {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String? // preserved even if the user row is later removed

  action     String // e.g. "booking.cancel"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([studioId, createdAt])
  @@index([entityType, entityId])
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  CONVERTED
  LOST
}

// Public "book a free trial" capture — deliberately no account required.
model Lead {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name    String
  email   String
  phone   String?
  message String?
  source  String? // e.g. "instagram"

  classInstanceId String?
  classInstance   ClassInstance? @relation(fields: [classInstanceId], references: [id], onDelete: SetNull)

  status             LeadStatus      @default(NEW)
  convertedStudentId String?
  convertedStudent   StudentProfile? @relation(fields: [convertedStudentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, status])
}

// -------------------------------------------------------------------- auth

/// A browser or installed PWA that agreed to receive push notifications.
/// One row per device — a student with a phone and a laptop has two.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Unique per browser install; the push service rejects duplicates.
  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // the raw token lives only in the cookie
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VerificationPurpose {
  MAGIC_LINK
  PASSWORD_RESET
  EMAIL_VERIFY
  STUDIO_CHOICE
}

model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  /// STUDIO_CHOICE only: { userIds: [...] } — the accounts already proven to
  /// this visitor, so the picker cannot be used to reach any other account.
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
}

// -------------------------------------------------------- platform billing

/**
 * What a studio owes TEMPPO — the opposite direction from Payment, which is a
 * student paying their studio. The two flows never mix: subscription money is
 * ours, so it stays out of Transaction and out of every studio-facing report.
 */
enum SubscriptionStatus {
  /// Preapproval created; waiting for the owner to authorise it at the provider.
  PENDING
  ACTIVE
  /// A scheduled charge failed. Access is deliberately untouched — a human decides.
  PAST_DUE
  PAUSED
  CANCELLED
}

model Subscription {
  id String @id @default(cuid())

  /// One live subscription per studio. The history lives in SubscriptionCharge,
  /// so a studio that cancels and comes back reuses this row.
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  plan        Plan
  status      SubscriptionStatus @default(PENDING)
  amountCents Int
  currency    String             @default("UYU")

  /// null while the studio is settled by hand (transfer, cash).
  provider    String?
  /// Mercado Pago preapproval id. Unique so a webhook can find its row.
  providerRef String? @unique

  /// Paid up to. Auto-debit takes this from the provider's next charge date; a
  /// manually recorded payment pushes it out a month at a time.
  currentPeriodEnd DateTime?
  lastPaymentAt    DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges SubscriptionCharge[]

  @@index([status])
}

model SubscriptionCharge {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Denormalised so the platform console can list a studio's charges without
  /// joining through the subscription.
  studioId String

  amountCents Int
  currency    String        @default("UYU")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  provider          String?
  /// Unique: the provider retries webhooks, and a charge must be credited once.
  providerPaymentId String? @unique

  /// How many months this charge paid for. Voiding one hands exactly this much
  /// time back, which is only possible because it is written down here.
  months Int @default(1)

  /// The manual path only: "transferencia BROU 21/08".
  note         String?
  /// Platform admin who recorded a manual payment. Deliberately not a relation
  /// — User rows are tenant-scoped and this points across tenants.
  recordedById String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([studioId, createdAt])
  @@index([subscriptionId, createdAt])
}

/**
 * What each plan costs, per month, in PLATFORM_CURRENCY cents.
 * Prices started life as constants, which made every price change a deploy.
 * Rows here override the code defaults; an empty table means the defaults
 * stand, so this can never leave the platform unable to quote a price.
 */
model PlanPrice {
  plan        Plan     @id
  amountCents Int
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ------------------------------------------------------------ appointments

model ServiceCategory {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)

  services Service[]

  @@index([studioId, position])
}

enum DepositType {
  NONE
  PERCENT
  FIXED
}

model Service {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name        String
  description String?
  durationMin Int
  priceCents  Int

  depositType  DepositType @default(NONE)
  /// Percent (0–100) for PERCENT, cents for FIXED.
  depositValue Int         @default(0)

  /// Prep before and cleanup after. Not shown to the client, but it keeps the
  /// professional's chair blocked.
  bufferBeforeMin Int @default(0)
  bufferAfterMin  Int @default(0)

  /// "Te toca volver": nudge the client this many days after a visit when she
  /// has not booked again. Null turns it off for this service.
  rebookAfterDays Int?

  colorHex String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        ServiceStaff[]
  addOns       AddOn[]
  appointments Appointment[]

  @@index([studioId, isActive])
}

/// Who performs a service, optionally at their own pace or price — a senior
/// colourist is slower and dearer than a junior one.
model ServiceStaff {
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  durationMin Int?
  priceCents  Int?

  @@id([serviceId, staffId])
  @@index([staffId])
}

/// An extra that lengthens and adds to a service: nail art, removal of the old
/// set. Null serviceId offers it with every service.
model AddOn {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name        String
  durationMin Int     @default(0)
  priceCents  Int     @default(0)
  isActive    Boolean @default(true)

  @@index([studioId, isActive])
}

/// One shift on one weekday. Two rows on the same day make a split shift.
model WorkingHours {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffId  String
  staff    User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  weekday  Int // 0=Sunday..6=Saturday, studio time
  startMin Int // minutes since local midnight
  endMin   Int

  @@index([staffId, weekday])
  @@index([studioId])
}

/// A block on the agenda: holidays, a doctor's appointment, lunch. No staffId
/// closes the whole business.
model TimeOff {
  id       String  @id @default(cuid())
  studioId String
  studio   Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffId  String?
  staff    User?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime
  reason   String?

  createdAt DateTime @default(now())

  @@index([studioId, startsAt])
  @@index([staffId, startsAt])
}

enum AppointmentStatus {
  /// Holding the slot until the deposit arrives or holdExpiresAt passes.
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  LATE_CANCELLED
  COMPLETED
  NO_SHOW
  /// The hold ran out unpaid.
  EXPIRED
}

enum AppointmentSource {
  CLIENT_PUBLIC
  STAFF
}

enum DepositStatus {
  NONE
  PENDING
  PAID
  /// Kept by the studio: a late cancellation or a no-show.
  FORFEITED
  /// Owed back to the client. Refunds are settled by hand for now.
  REFUNDED
  /// Kept as credit towards a future visit.
  CREDIT
}

/// A 1:1 booking with one professional.
///
/// Double-booking is prevented in the database, not just in code: the
/// migration adds an exclusion constraint (appointment_no_overlap) over
/// (staffId, [startsAt, blockedUntil)) for live statuses. Prisma does not model
/// it, so it lives only in the migration SQL — do not remove it there.
model Appointment {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  staffId   String
  staff     User           @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: Cascade)
  clientId  String
  client    StudentProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Snapshot, so renaming or repricing the service leaves history alone.
  serviceName  String
  startsAt     DateTime
  endsAt       DateTime
  /// endsAt plus the cleanup buffer: when the chair is actually free again.
  blockedUntil DateTime

  status AppointmentStatus @default(CONFIRMED)
  source AppointmentSource @default(STAFF)

  priceCents    Int
  depositCents  Int           @default(0)
  depositStatus DepositStatus @default(NONE)
  holdExpiresAt DateTime?

  /// sha256 of the token in the client's manage link.
  manageTokenHash String @unique

  clientNotes  String?
  staffNotes   String?
  cancelledAt  DateTime?
  cancelReason String?

  remindersSentAt DateTime?
  rebookNudgedAt  DateTime?

  rescheduledFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addOns   AppointmentAddOn[]
  payments Payment[]

  @@index([studioId, startsAt])
  @@index([staffId, startsAt])
  @@index([clientId, startsAt])
  @@index([status, holdExpiresAt])
}

model AppointmentAddOn {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  addOnId       String?

  name        String
  durationMin Int
  priceCents  Int

  @@index([appointmentId])
}

enum PayoutStatus {
  PENDING
  PAID
}

/// Deposits the platform collected online on a studio's behalf, handed over in
/// one transfer. The payments it settles point back at it through payoutId.
model StudioPayout {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String       @default("UYU")
  status      PayoutStatus @default(PAID)
  paidAt      DateTime?
  /// "transferencia BROU 21/08"
  reference   String?
  notes       String?
  /// Platform admin. Not a relation — User rows are tenant-scoped.
  createdById String?

  createdAt DateTime @default(now())

  payments Payment[]

  @@index([studioId, createdAt])
}

/// What staff see under the bell in the panel: new bookings, cancellations,
/// deposits, leads. Written alongside the email and push for the same event,
/// so nothing depends on a device having push switched on.
model InboxItem {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The notification template, e.g. "appointment_new".
  kind  String
  title String
  body  String
  url   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
