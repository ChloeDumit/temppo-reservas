# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/temppo_reservas?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Sub-path the app is served from. Empty in development; "/reservas" when
# deployed behind temppo.uy. Must match the proxy rule on the marketing site.
NEXT_PUBLIC_BASE_PATH=""

# Shared secret for the reminder cron job (required in production)
CRON_SECRET=""

# --- Email (Resend). Leave blank in dev to log magic links to the console ---
RESEND_API_KEY=""
# Until temppo.app is verified in Resend, only onboarding@resend.dev works,
# and it can only deliver to the email on the Resend account itself.
EMAIL_FROM="TEMPPO Reservas <onboarding@resend.dev>"

# --- WhatsApp (Phase 2) ---
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# --- Payments (Phase 2) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Web Push (PWA notifications) ---
# Regenerate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ prefix is required: the browser needs the public key to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@temppo.uy"
