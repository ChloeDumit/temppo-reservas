# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/temppo_reservas?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Sub-path the app is served from. Empty in development; "/reservas" when
# deployed behind temppo.uy. Must match the proxy rule on the marketing site.
NEXT_PUBLIC_BASE_PATH=""

# Shared secret for the reminder cron job (required in production)
CRON_SECRET=""

# --- Email (Resend). Leave blank in dev to log magic links to the console ---
RESEND_API_KEY=""
# Until temppo.app is verified in Resend, only onboarding@resend.dev works,
# and it can only deliver to the email on the Resend account itself.
EMAIL_FROM="TEMPPO Reservas <onboarding@resend.dev>"
# Platform operator's address. Gets an alert whenever a new studio signs up.
# Leave blank to disable — signups are silent without it.
OPS_EMAIL=""


# --- Payments: students paying their studio ---
# The account that collects pack payments. Webhook: /api/payments/webhook
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Billing: studios paying TEMPPO ---
# Optional. Mercado Pago allows one webhook URL per application, so both flows
# can share a single application: leave these blank and subscriptions fall back
# to the token and signing key above, with /api/payments/webhook handling both
# the "Pagos" and "Planes y suscripciones" events.
#
# Set them only when subscriptions get an application of their own — then point
# that application's webhook at /api/billing/webhook and subscribe it to
# "Planes y suscripciones" alone.
#
# With neither these nor MERCADOPAGO_ACCESS_TOKEN set, the billing page shows
# the pay-by-transfer notice instead of a subscribe button.
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=""
MERCADOPAGO_PLATFORM_WEBHOOK_SECRET=""

# --- Web Push (PWA notifications) ---
# Regenerate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ prefix is required: the browser needs the public key to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@temppo.uy"
