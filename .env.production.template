# TEMPPO Reservas — production environment template
#
# Netlify: Site configuration → Environment variables → Import from a .env file.
#
# Every value here is a PLACEHOLDER. This file is committed, so no real secret
# may ever be written into it — the live values belong in Netlify's dashboard
# and in your local .env (which is gitignored).

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Use the POOLED connection string, not the direct one. Netlify Functions are
# Lambdas and scale to many concurrent instances; a direct connection will
# exhaust Postgres under normal traffic.
#   Supabase → Connection string → Transaction pooler (port 6543)
#   Neon     → the host containing "-pooler"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE"

# ─────────────────────────────────────────────────────────────
# Where the app lives
# ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Magic links, QR check-in codes, waitlist
# claim links and payment return URLs are all built from this — if it is wrong,
# those links point somewhere that does not exist.
#
# The app runs on its own subdomain, so it needs no sub-path. Leave BASE_PATH
# empty: setting it makes Next serve everything under that prefix, and the bare
# prefix (/reservas with no trailing slash) does not resolve — which is what
# produced the 404 when this was proxied from temppo.uy/reservas.
APP_URL="https://reservas.temppo.uy"
NEXT_PUBLIC_BASE_PATH=""

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 32
AUTH_SECRET="GENERATE_ME"

# Guards the reminder cron. The scheduled function sends it as a bearer token;
# without it the route refuses to run in production.
CRON_SECRET="GENERATE_ME"

# ─────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────
# resend.com → API Keys. Verify temppo.uy under Domains before using an
# @temppo.uy sender, or Resend rejects the send and students get no email.
RESEND_API_KEY="re_YOUR_KEY_HERE"
EMAIL_FROM="TEMPPO Reservas <no-reply@temppo.uy>"

# ─────────────────────────────────────────────────────────────
# Web Push
# ─────────────────────────────────────────────────────────────
# Copy the pair already generated in your local .env — changing them
# invalidates every push subscription your students have made.
# A fresh pair comes from:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="COPY_FROM_YOUR_LOCAL_ENV"
VAPID_PRIVATE_KEY="COPY_FROM_YOUR_LOCAL_ENV"
VAPID_SUBJECT="mailto:hola@temppo.uy"

# ─────────────────────────────────────────────────────────────
# Mercado Pago — optional
# ─────────────────────────────────────────────────────────────
# Leave blank and the app hides the "Pagar con Mercado Pago" button; students
# pay by transfer and send the receipt over WhatsApp instead.
# mercadopago.com.uy → Tus integraciones → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=""
# Shown when you register the webhook at {APP_URL}/api/payments/webhook (Pagos)
MERCADOPAGO_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# WhatsApp Business API — optional
# ─────────────────────────────────────────────────────────────
# Only for sending automated messages. The receipt flow students use is a
# plain wa.me link and needs none of this — that number is set per studio in
# Ajustes. Left blank, notifications fall back to push and email.
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
